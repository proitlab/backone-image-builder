. /etc/backone-release

# Netify NFT Rule to block
#nft -f /etc/nftables.d/10-netify.nft

echo $BACKONE_MODEL > /tmp/sysinfo/model
echo $BACKONE_BOARD_NAME > /tmp/sysinfo/board_name

# Update Serial Number
/usr/bin/update_serial.sh ${NAME}

# Configurations
/usr/bin/config-rtty.sh
/usr/bin/config-dnsmasq.sh
/usr/bin/config-dropbear.sh

exit 0
